{
  "name": "incovice-management-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "check-db": "npx tsx scripts/maintenance/check-db.ts",
    "db:clear": "npx tsx scripts/maintenance/clear-db.ts",
    "reminders:run": "node --env-file=.env scripts/automation/run-reminders.js",
    "integration:sarvam:voice": "node --env-file=.env scripts/integration/sarvam-voice.js",
    "integration:sarvam:vision": "node --env-file=.env scripts/integration/sarvam-vision.js",
    "ai:test": "npx tsx scripts/ai/run-ai-tests.ts",
    "ai:unit": "npx --yes tsx tests/ai/run-all.ts",
    "ai:seed": "node --import tsx --import ./scripts/ai/loaders/register.mjs scripts/ai/seed-recovery-data.ts",
    "ai:seed:prod": "npx tsx scripts/ai/seed-production.ts",
    "ai:train": "python3 ai/ml/training/train.py",
    "ai:eval": "python3 ai/ml/training/train.py --dry-run",
    "qa:simulate-failures": "npx tsx scripts/ai/simulate-failures.ts",
    "ai:evaluate": "npx tsx scripts/ai/evaluate-recovery.ts",
    "ai:verify": "DISABLE_LLM_AGENT=true node --import tsx --import ./scripts/ai/loaders/register.mjs scripts/ai/verify-local.ts",
    "ai:batch": "DISABLE_LLM_AGENT=true node --import tsx --import ./scripts/ai/loaders/register.mjs scripts/ai/run-hackathon-batch.ts",
    "ai:scheduled-actions": "node --import tsx --import ./scripts/ai/loaders/register.mjs scripts/ai/process-scheduled-actions.ts",
    "ai:verify:batch": "node --import tsx --import ./scripts/ai/loaders/register.mjs scripts/ai/verify-hackathon-batch.ts",
    "ai:demo-learning": "npx tsx scripts/ai/demo-learning-loop.ts",
    "test:e2e:recovery": "playwright test tests/e2e/recovery.spec.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "5.22.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "fast-xml-parser": "^5.3.6",
    "googleapis": "^171.4.0",
    "html2canvas": "^1.4.1",
    "jimp": "^1.6.0",
    "js-yaml": "^4.1.1",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.38.0",
    "next": "16.1.4",
    "next-auth": "5.0.0-beta.30",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "sarvamai": "^1.1.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tsx": "4.19.3",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jspdf": "^2.0.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
